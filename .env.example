# Copy to .env for local dev (netlify dev), and add the same keys in
# Netlify > Site configuration > Environment variables for production.

# Password that protects the whole site. Use something long.
APP_PASSWORD=change-me-to-something-long

# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox (fake test banks) or production (your real Chase account)
PLAID_ENV=sandbox

# Required for Chase in production (Chase uses OAuth).
# Must exactly match a redirect URI registered in the Plaid dashboard.
# Example: https://your-site.netlify.app/
PLAID_REDIRECT_URI=
